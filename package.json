{
  "name": "photobook-studio",
  "version": "0.1.23",
  "private": true,
  "type": "module",
  "description": "Local-first photobook editor: import, auto-draft, edit, export print-ready PDF.",
  "scripts": {
    "dev": "npm run dev:editor",
    "dev:editor": "concurrently -k -n server,web -c blue,magenta \"tsx watch --clear-screen=false photobook-editor/server/main.ts\" \"vite --config photobook-editor/vite.config.ts\"",
    "build": "npm run build:editor",
    "build:editor": "tsc --noEmit && vite build --config photobook-editor/vite.config.ts",
    "start": "tsx photobook-editor/server/main.ts --production",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "demo-photos": "tsx scripts/make-demo.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "e2e:editor": "playwright test --project=editor",
    "typecheck": "tsc --noEmit",
    "dev:photo-tool": "concurrently -k -n server,web -c blue,magenta \"tsx watch --clear-screen=false photo-tool/server/main.ts\" \"vite --config photo-tool/vite.config.ts\"",
    "build:photo-tool": "tsc --noEmit && vite build --config photo-tool/vite.config.ts",
    "e2e:photo-tool": "playwright test --project=photo-tool",
    "build:pages": "tsc --noEmit && vite build --config photobook-editor/vite.config.ts --mode pages",
    "preview:pages": "vite preview --config photobook-editor/vite.config.ts --mode pages --port 5190 --strictPort",
    "launcher": "bash scripts/make-launcher.sh",
    "dev:desktop": "node scripts/desktop/dev.mjs",
    "desktop:build": "npm run build && node scripts/desktop/ensure-electron.mjs && node scripts/desktop/build.mjs",
    "start:desktop": "electron dist/desktop/app",
    "dist": "npm run desktop:build && electron-builder --config electron-builder.config.cjs --publish never",
    "dist:dir": "npm run desktop:build && electron-builder --config electron-builder.config.cjs --publish never --dir"
  },
  "dependencies": {
    "@fontsource/abril-fatface": "^5.3.0",
    "@fontsource/amatic-sc": "^5.3.0",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@fontsource/work-sans": "^5.3.0",
    "@huggingface/transformers": "4.3.2",
    "@hyzyla/pdfium": "^3.0.0",
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "immer": "^11.2.9",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "libheif-js": "^1.23.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.20.2",
    "polygon-clipping": "^0.15.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "elheif": "^0.1.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
